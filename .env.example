APP_NAME="کلید"
APP_NAME_EN=KEY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keydb
DB_USERNAME=keyuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=key_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=key_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@key.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# پیامک — درایور فعال: log | kavenegar | smsir | mellipayamak | faraz
# کلیدها از پنل مدیریت (تنظیمات) نیز قابل ثبت هستند و ترجیحاً همان‌جا ثبت شود
# ---------------------------------------------------------------------------
SMS_DRIVER=log
SMS_KAVENEGAR_KEY=
SMS_SMSIR_KEY=
SMS_SMSIR_SECRET=
SMS_MELLI_USERNAME=
SMS_MELLI_PASSWORD=
SMS_FARAZ_API_KEY=
SMS_SENDER_NUMBER=

# ---------------------------------------------------------------------------
# پرداخت — درگاه پیش‌فرض آزمایشی (mock) است؛ برای درگاه واقعی zarinpal کلید ثبت شود
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=mock
PAYMENT_ZARINPAL_MERCHANT_ID=

# ---------------------------------------------------------------------------
# هوش مصنوعی (اختیاری) — openai | gemini | none
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"
